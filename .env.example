# LLM API
OPENAI_API_KEY=
SUPERVISOR_MODEL=gpt-4o
WORKER_MODEL=gpt-4o-mini

# Optional Tavily key. Without this, search returns mock results.
TAVILY_API_KEY=

APP_PORT=8000
MAX_CONCURRENT_WORKERS=3
MAX_SEARCH_RESULTS=5
REPORTS_DIR=./reports
UPLOADS_DIR=./uploads
STATE_DIR=./state

# Use local for development. Set to s3 on EC2.
STORAGE_BACKEND=local
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=research-platform
